<Page
    x:Class="Invoice.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Invoice"
    xmlns:vm="clr-namespace:Invoice.ViewModels"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    mc:Ignorable="d"
    d:Background="White"
    d:DesignHeight="500"
    d:DesignWidth="800"
    FontFamily="Biz UDGothic"
    Title="Customer"
      Tag="利用者管理">
    <Grid>
        <Grid
            Grid.Row="1"
            x:Name="CustomerPageContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="50" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Width="500"
                MaxWidth="500"
                MinWidth="500"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <Label
                    Content="利用者一覧"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,20" />
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="削除者"
                        VerticalAlignment="Center" />
                    <ui:ToggleSwitch
                        x:Name="ShowAllCustomer"
                        Margin="10,0,0,0"
                        Width="100"
                        OnContent="表示"
                        OffContent="非表示"
                        Toggled="ShowAllCustomer_Toggled" />
                </StackPanel>

            </Grid>
            <DataGrid
                x:Name="CustomerListDataGrid"
                Grid.Row="2"
                ItemsSource="{Binding CustomerVM.CustomerCollectionViewSource.View}"
                AlternatingRowBackground="#0C000000"
                MouseDoubleClick="CustomerListView_MouseDoubleClick"
                ColumnHeaderHeight="28"
                RowHeaderWidth="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="False"
                AutoGenerateColumns="False"
                SelectionUnit="FullRow"
                BorderBrush="LightGray"
                BorderThickness="1"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                CellStyle="{StaticResource CustomDataGridCellStyle}"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                FontSize="20"
                Width="500"
                MaxWidth="500"
                MinWidth="500"
                >
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="30">
                        <DataGridTemplateColumn.Header>
                            <CheckBox
                                x:Name="CustomerSelectAllCheckBox"
                                Checked="SelectAllChecked_Checked"
                                Unchecked="SelectAllChecked_Unchecked" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    x:Name="CustomerCheckBox"
                                    IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},Path=IsSelected,Mode=TwoWay}"
                                    Style="{StaticResource RowCheckBoxStyle}"
                                    PreviewMouseLeftButtonDown="CustomerCheckBox_PreviewMouseLeftButtonDown"
                                    Width="20">
                                    <CheckBox.Resources>
                                        <Style
                                            TargetType="Grid">
                                            <Setter
                                                Property="Width"
                                                Value="20" />
                                        </Style>
                                        <Style
                                            TargetType="Border">
                                            <Setter
                                                Property="Width"
                                                Value="20" />
                                        </Style>
                                    </CheckBox.Resources>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn
                        Header="ID"
                        Width="100"
                        CellStyle="{StaticResource DataGridNameCellStyle}"
                        FontSize="20"
                        Binding="{Binding CustomerId}"/>
                    <DataGridTextColumn Header="名前"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignCenter}"
                                            Width="180"
                                        IsReadOnly="True"
                                        FontSize="20"
                                            Binding="{Binding CustomerName}"/>
                    <DataGridTextColumn
                        Header="請求残高"
                        Width="170"
                        CellStyle="{StaticResource DataGridAmountCellStyle}"
                        FontSize="20"
                        Binding="{Binding CustomerBalance,StringFormat={}￥{0:N0}‐}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel
                Grid.Row="3"
                Width="500"
                MaxWidth="500"
                MinWidth="500"
                Orientation="Horizontal">
                <Button
                    x:Name="AddCustomerButton"
                    Content="新規利用者登録"
                    Width="130"
                    Height="30"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="AddCustomerButton_Click"/>
                <Button
                    x:Name="EditCustomerButton"
                    Content="利用者情報編集"
                    Width="130"
                    Height="30"
                    Margin="10,10,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="EditCustomerButton_Click" />
                <Button
                    x:Name="DeleteCustomerButton"
                    Content="利用者削除"
                    Width="130"
                    Height="30"
                    Margin="10,10,0,10"
                    Click="DeleteCustomerButton_Click" />

            </StackPanel>
        </Grid>
        
        <Border
            x:Name="CustomerDetailPane"
            Grid.Row="1"
            Background="White"
            BorderBrush="Gray"
            BorderThickness="1"
            Height="300"
            VerticalAlignment="Bottom"
            RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform
                    x:Name="CustomerDetailPaneTransform"
                    Y="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Height}" />
            </Border.RenderTransform>
            
            <StackPanel
                Orientation="Vertical"
                Margin="20">
                <StackPanel.Resources>
                    <Style
                        TargetType="StackPanel">
                        <Setter
                            Property="Orientation"
                            Value="Horizontal" />
                        <Setter
                            Property="Margin"
                            Value="0,0,0,10" />
                    </Style>
                    <Style
                        TargetType="TextBlock"
                        BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter
                            Property="Width"
                            Value="100" />
                        <Setter
                            Property="FontSize"
                            Value="24" />

                    </Style>
                    <Style
                        TargetType="TextBox"
                        BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter
                            Property="Width"
                            Value="200" />
                    </Style>
                </StackPanel.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        Content="利用者情報編集"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,0,0,20" />
                    <StackPanel
                        x:Name="VisibleSwitchStackPanel"
                        HorizontalAlignment="Right"
                        Grid.Column="1"
                        >
                        <TextBlock
                            Text="表示"
                            Width="50" />
                        <ui:ToggleSwitch
                            OnContent="表示"
                            OffContent="非表示"
                            Width="100"
                            IsOn="{Binding CustomerVM.SelectedCustomer.CustomerVisible,Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock
                        Text="ID" />
                    <TextBlock
                        x:Name="CustomerIdTextBlock"
                               Text="{Binding CustomerVM.SelectedCustomer.CustomerId}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        Text="名前" />
                    <TextBox
                        x:Name="CustomerNameTextBox"
                        InputMethod.PreferredImeState="On"
                        InputMethod.PreferredImeConversionMode="FullShape,Native"
                             Text="{Binding CustomerVM.SelectedCustomer.CustomerName,Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        Text="カナ" />
                    <TextBox
                        x:Name="CustomerKanaTextBox"
                        InputMethod.PreferredImeState="On"
                        InputMethod.PreferredImeConversionMode="Katakana,FullShape"
                             Text="{Binding CustomerVM.SelectedCustomer.CustomerKana,Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        Text="請求残高" />
                    <TextBox
                        x:Name="CustomerBalanceTextBox"
                        TextAlignment="Right"
                        InputMethod.IsInputMethodEnabled="False"
                             Text="{Binding CustomerVM.SelectedCustomer.CustomerBalance, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="SaveButton"
                        Content="保存"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click" />
                    <Button
                        x:Name="CancelButton"
                        Content="キャンセル"
                        Width="80"
                        Click="CancelButton_Click" />


                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="CustomerBalancePane"
                Grid.Row="1"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                Height="400"
                VerticalAlignment="Bottom"
                RenderTransformOrigin="0.5,1"
                >
            <Border.RenderTransform>
                <TranslateTransform x:Name="CustomerBalancePaneTransform"
                                    Y="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Height}" />
            </Border.RenderTransform>
            <Grid x:Name="CustomerBalancePaneGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="CustomerBalanceDataGrid"
                          Grid.Row="0"
                          VerticalAlignment="Stretch"
                          Margin="10,5,10,0"
                          CanUserAddRows="False"
                          CanUserResizeColumns="False"
                          AutoGenerateColumns="False"
                          BorderBrush="Gray"
                          BorderThickness="1"
                          ItemsSource="{Binding CustomerVM.BalanceCollectionViewSource.View}"
                          ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                          AlternatingRowBackground="#0C000000"
                          ColumnHeaderHeight="30"
                          CanUserDeleteRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付"
                                            Binding="{Binding DateString}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignCenter}"
                                            Width="200*"/>
                        <DataGridTextColumn Header="氏名"
                                            Binding="{Binding CustomerName}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignCenter}"
                                            Width="150*"/>
                        <DataGridTextColumn Header="伝票番号"
                                            Binding="{Binding SlipNumber}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignCenter}"
                                            Width="100*"/>
                        <DataGridTextColumn Header="取引種別"
                                            Width="100*"
                                            Binding="{Binding TransactionTypeName}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignCenter}"/>
                        <DataGridTextColumn Header="借方"
                                            Width="100*"
                                            Binding="{Binding DebitAmount, StringFormat={}{0:N0}}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignRight}"/>
                        <DataGridTextColumn Header="貸方"
                                            Width="100*"
                                            Binding="{Binding CreditAmount, StringFormat={}{0:N0}}"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource Cellstyle_HorizontalAlignRight}"/>

                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1"
>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="未収残高"/>
                    <Border Grid.Column="2"
                            BorderThickness="0.5"
                            BorderBrush="Black"
                            CornerRadius="2"
                            HorizontalAlignment="Right"
                            Width="150"
                            Height="35"
                            Margin="20,0">
                            <TextBlock
                                VerticalAlignment="Center"   
                                TextAlignment="Right"
                                Padding="0,0,10,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{Binding CustomerVM.CustomerBalance, StringFormat={}\\{0:N0}, Mode=OneWay}"/>
                            
                    </Border>
                    <Button x:Name="BackToCustomerListButton"
                            Grid.Column="3"
                            Margin="0,10,20,10"
                            Height="30"
                            Width="100"
                            Click="BackToCustomerListButton_Click"
                            Content="戻る"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
